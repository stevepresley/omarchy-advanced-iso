#!/bin/bash

# Exit on any error
set -eEo pipefail

# Set OMARCHY_PATH before sourcing helpers (needed for logo.txt and other file references)
export OMARCHY_PATH="/root/omarchy"

# Source ONLY presentation helpers for styling functions (gum, clear_logo, etc)
# Do NOT source helpers/all.sh because it sets up error traps that reference the log file
# The .automated_script.sh handles logging initialization and error handling
OMARCHY_INSTALL="$OMARCHY_PATH/install"
source "$OMARCHY_INSTALL/helpers/presentation.sh"

# Ensure tzupdate is available for guessing timezone
command -v tzupdate >/dev/null || sudo pacman -Sy --noconfirm tzupdate

CONFIG_LOG="/tmp/configurator.log"
touch "$CONFIG_LOG" 2>/dev/null || true

log_debug() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$CONFIG_LOG"
}

INSTALL_MODE=""
INSTALL_DISK=""
BOOT_PARTITION=""
SUMMARY_INSTALL_TARGET=""
SUMMARY_BOOT_TARGET=""

cleanup_disk_children() {
  local disk="$1"
  log_debug "Detaching existing mappings on $disk"
  {
    echo "--- lsblk tree for $disk ---"
    lsblk -lnpo NAME,TYPE,MOUNTPOINTS "$disk"
    echo "--- /proc/swaps ---"
    cat /proc/swaps
  } >>"$CONFIG_LOG" 2>&1

  while read -r child child_type; do
    [[ -z "$child" ]] && continue
    log_debug "Processing child $child (type=$child_type)"
    case "$child_type" in
      part)
        if awk 'NR>1 {print $1}' /proc/swaps 2>/dev/null | grep -Fxq "$child"; then
          log_debug "swapoff $child"
          swapoff "$child" >>"$CONFIG_LOG" 2>&1 || log_debug "swapoff failed for $child"
        fi
        mapfile -t targets < <(findmnt -rn "$child" -o TARGET 2>/dev/null || true)
        if ((${#targets[@]})); then
          mapfile -t targets < <(printf '%s\n' "${targets[@]}" | awk 'NF' | sort -r)
        fi
        for target in "${targets[@]}"; do
          [[ -z "$target" ]] && continue
          log_debug "umount $target"
          if ! umount "$target" >>"$CONFIG_LOG" 2>&1; then
            log_debug "umount failed for $target, retrying with -R"
            umount -R "$target" >>"$CONFIG_LOG" 2>&1 || log_debug "umount -R failed for $target"
          fi
        done
        ;;
      crypt)
        mapfile -t targets < <(findmnt -rn "$child" -o TARGET 2>/dev/null || true)
        if ((${#targets[@]})); then
          mapfile -t targets < <(printf '%s\n' "${targets[@]}" | awk 'NF' | sort -r)
        fi
        for target in "${targets[@]}"; do
          [[ -z "$target" ]] && continue
          log_debug "umount $target (crypt)"
          if ! umount "$target" >>"$CONFIG_LOG" 2>&1; then
            log_debug "umount failed for $target, retrying with -R"
            umount -R "$target" >>"$CONFIG_LOG" 2>&1 || log_debug "umount -R failed for $target"
          fi
        done
        if command -v cryptsetup >/dev/null 2>&1; then
          local mapper_name
          mapper_name=$(lsblk -no NAME "$child" 2>/dev/null | head -n1)
          if [[ -n "$mapper_name" ]]; then
            log_debug "Closing LUKS mapping $mapper_name"
            cryptsetup close "$mapper_name" >>"$CONFIG_LOG" 2>&1 || log_debug "Failed to close $mapper_name"
          fi
        fi
        ;;
      *)
        log_debug "No cleanup actions for child type $child_type"
        ;;
    esac
  done < <(lsblk -lnpo NAME,TYPE "$disk" | tail -n +2)

  if command -v udevadm >/dev/null 2>&1; then
    udevadm settle >>"$CONFIG_LOG" 2>&1 || true
  fi
}

select_boot_partition() {
  local root_part="$1"
  local root_disk
  root_disk=$(lsblk -no PKNAME "$root_part" 2>/dev/null | head -n1)

  local candidate_names=()
  local candidate_display=()

  while read -r name fstype size type mountpoint pkname; do
    [[ "$type" != "part" ]] && continue
    [[ "$name" == "$root_part" ]] && continue
    case "$fstype" in
      vfat|fat|fat32|efi|msdos) ;;
      *) continue ;;
    esac
    local display="$name ($size, ${fstype:-unknown}"
    if [[ -n "$mountpoint" ]]; then
      display="$display, mounted at $mountpoint"
    fi
    if [[ -n "$root_disk" && "$pkname" == "$root_disk" ]]; then
      display="$display, same disk"
    fi
    display="$display)"
    candidate_names+=("$name")
    candidate_display+=("$display")
  done < <(lsblk -lnpo NAME,FSTYPE,SIZE,TYPE,MOUNTPOINT,PKNAME)

  if ((${#candidate_names[@]} == 0)); then
    abort "No FAT/EFI partition found. Create an ESP before continuing."
  fi

  if ((${#candidate_names[@]} == 1)); then
    echo "${candidate_names[0]}"
    return 0
  fi

  local default_display=""
  if [[ -n "$BOOT_PARTITION" ]]; then
    for i in "${!candidate_names[@]}"; do
      if [[ "${candidate_names[$i]}" == "$BOOT_PARTITION" ]]; then
        default_display="${candidate_display[$i]}"
        break
      fi
    done
  fi

  local selection
  if [[ -n "$default_display" ]]; then
    selection=$(printf '%s\n' "${candidate_display[@]}" | gum choose --header "Select EFI/boot partition" --selected "$default_display") || abort
  else
    selection=$(printf '%s\n' "${candidate_display[@]}" | gum choose --header "Select EFI/boot partition") || abort
  fi

  for i in "${!candidate_display[@]}"; do
    if [[ "${candidate_display[$i]}" == "$selection" ]]; then
      echo "${candidate_names[$i]}"
      return 0
    fi
  done

  abort "Invalid boot partition selection"
}

prepare_disk_layout() {
  local disk="$1"
  cleanup_disk_children "$disk"

  log_debug "Creating ESP and root partitions on $disk"
  if ! wipefs -a "$disk" >>"$CONFIG_LOG" 2>&1; then
    log_debug "wipefs failed on $disk"
    abort "Failed to wipe disk signatures"
  fi
  if ! parted -s "$disk" mklabel gpt >>"$CONFIG_LOG" 2>&1; then
    abort "Failed to create GPT label"
  fi
  if ! parted -s "$disk" mkpart primary fat32 1MiB 2049MiB >>"$CONFIG_LOG" 2>&1; then
    abort "Failed to create FAT32 boot partition"
  fi
  parted -s "$disk" set 1 esp on >>"$CONFIG_LOG" 2>&1 || abort "Failed to mark ESP partition"
  if ! parted -s "$disk" mkpart primary btrfs 2049MiB 100% >>"$CONFIG_LOG" 2>&1; then
    abort "Failed to create root partition"
  fi
  partprobe "$disk" >>"$CONFIG_LOG" 2>&1 || true
  if command -v udevadm >/dev/null 2>&1; then
    udevadm settle >>"$CONFIG_LOG" 2>&1 || true
  fi

  BOOT_PARTITION=$(lsblk -lnpo NAME "$disk" | awk 'NR==2')
  partition=$(lsblk -lnpo NAME "$disk" | awk 'NR==3')
  SUMMARY_BOOT_TARGET="$BOOT_PARTITION"
  log_debug "Created boot partition $BOOT_PARTITION and root partition $partition on $disk"
}

prepare_install_target() {
  if [[ "$INSTALL_MODE" == "disk" ]]; then
    [[ -z "$INSTALL_DISK" ]] && abort "No disk selected for installation"
    prepare_disk_layout "$INSTALL_DISK"
  else
    [[ -n "$BOOT_PARTITION" ]] || BOOT_PARTITION=$(select_boot_partition "$partition")
    SUMMARY_BOOT_TARGET="$BOOT_PARTITION"
    log_debug "Using boot partition $BOOT_PARTITION for installation"
  fi
}

mount_boot_partition() {
  if [[ -z "${BOOT_PARTITION:-}" ]]; then
    log_debug "No boot partition defined; skipping mount"
    return
  fi

  local existing_target
  existing_target=$(findmnt -rn "$BOOT_PARTITION" -o TARGET 2>/dev/null || true)
  if [[ -n "$existing_target" ]]; then
    log_debug "Unmounting $BOOT_PARTITION from $existing_target"
    umount "$existing_target" >>"$CONFIG_LOG" 2>&1 || log_debug "Failed to unmount $existing_target"
  fi

  if [[ "$INSTALL_MODE" == "disk" ]]; then
    log_debug "Wiping filesystem signatures from $BOOT_PARTITION"
    wipefs -a "$BOOT_PARTITION" >>"$CONFIG_LOG" 2>&1 || log_debug "wipefs reported issues on $BOOT_PARTITION"
    log_debug "Formatting $BOOT_PARTITION as FAT32"
    if ! mkfs.vfat -F32 "$BOOT_PARTITION" >>"$CONFIG_LOG" 2>&1; then
      abort "Failed to format boot partition $BOOT_PARTITION"
    fi
  fi

  log_debug "Mounting $BOOT_PARTITION at /mnt/archinstall/boot"
  if ! mount "$BOOT_PARTITION" /mnt/archinstall/boot >>"$CONFIG_LOG" 2>&1; then
    abort "Failed to mount boot partition $BOOT_PARTITION"
  fi
}

abort() {
  gum style "${1:-Aborted installation}"
  echo
  gum style "You can retry later by running: ./.automated_script.sh"
  exit 1
}

step() {
  clear_logo
  echo
  gum style "$1"
  echo
}

notice() {
  clear_logo
  echo
  gum spin --spinner "pulse" --title "$1" -- sleep "${2:-2}"
  echo
}

# STEP 0: INSTALLATION PROFILE

step "Welcome to Omarchy Advanced Installation"

# Show profile selection with detailed defaults
gum style --border normal --margin "1 0 1 $PADDING_LEFT" --padding "1 2" "Workstation - Disk encryption (requires boot password), no SSH, no VNC, keep Super keybindings
VM - No disk encryption, SSH, VNC, remap keybindings to CTRL+ALT

All options can be changed, these are just the defaults to save you time!
Note: Login screen (greetd) is always enabled for security."

echo

install_profile=$(gum choose --header "Select installation profile" "Workstation" "VM") || abort

notice "Configuring $install_profile profile..." 1

# STEP 1: KEYBOARD LAYOUT

keyboard_form() {
  step "Let's setup your machine..."
  keyboards=$'Azerbaijani|azerty\nBelarusian|by\nBelgian|be-latin1\nBosnian|ba\nBulgarian|bg-cp1251\nCroatian|croat\nCzech|cz\nDanish|dk-latin1\nDutch|nl\nEnglish (UK)|uk\nEnglish (US)|us\nEnglish (US, Dvorak)|dvorak\nEstonian|et\nFinnish|fi\nFrench|fr\nFrench (Canada)|cf\nFrench (Switzerland)|fr_CH\nGeorgian|ge\nGerman|de\nGerman (Switzerland)|de_CH-latin1\nGreek|gr\nHebrew|il\nHungarian|hu\nIcelandic|is-latin1\nIrish|ie\nItalian|it\nJapanese|jp106\nKazakh|kazakh\nKhmer (Cambodia)|khmer\nKyrgyz|kyrgyz\nLao|la-latin1\nLatvian|lv\nLithuanian|lt\nMacedonian|mk-utf\nNorwegian|no-latin1\nPolish|pl\nPortuguese|pt-latin1\nPortuguese (Brazil)|br-abnt2\nRomanian|ro\nRussian|ru\nSerbian|sr-latin\nSlovak|sk-qwertz\nSlovenian|slovene\nSpanish|es\nSpanish (Latin American)|la-latin1\nSwedish|sv-latin1\nTajik|tj_alt-UTF8\nTurkish|trq\nUkrainian|ua'
  choice=$(printf '%s\n' "$keyboards" | cut -d'|' -f1 | gum choose --height 10 --selected "English (US)" --header "Select keyboard layout") || abort
  keyboard=$(printf '%s\n' "$keyboards" | awk -F'|' -v c="$choice" '$1==c{print $2; exit}')

  # Only attempt to load keyboard layout if we're on a real console
  # loadkeys only works on Linux virtual consoles (tty), not in terminal emulators
  if [[ $(tty 2>/dev/null) == "/dev/tty"* ]]; then
    loadkeys "$keyboard" 2>/dev/null
  fi
}

keyboard_form

# STEP 2: USER

user_form() {
  step "Let's setup your user account..."

  while true; do
    username=$(gum input --placeholder "Alphanumeric without spaces (like dhh)" --prompt.foreground="#845DF9" --prompt "Username> ") || abort

    if [[ "$username" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
      break
    else
      notice "Username must be alphanumeric with no spaces" 1
    fi
  done

  while true; do
    password=$(gum input --placeholder "Used for user + root + encryption" --prompt.foreground="#845DF9" --password --prompt "Password> ") || abort
    password_confirmation=$(gum input --placeholder "Must match the password you just typed" --prompt.foreground="#845DF9" --password --prompt "Confirm> ") || abort

    if [[ -n "$password" && "$password" == "$password_confirmation" ]]; then
      break
    elif [[ -z "$password" ]]; then
      notice "Your password can't be blank!" 1
    else
      notice "Passwords didn't match!" 1
    fi
  done

  # Hash the password using yescrypt
  password_hash=$(openssl passwd -6 "$password")

  full_name=$(gum input --placeholder "Used for git authentication (hit return to skip)" --prompt.foreground="#845DF9" --prompt "Full name> ")
  email_address=$(gum input --placeholder "Used for git authentication (hit return to skip)" --prompt.foreground="#845DF9" --prompt "Email address> ")

  while true; do
    hostname=$(gum input --placeholder "Alphanumeric without spaces (or return for 'omarchy')" --prompt.foreground="#845DF9" --prompt "Hostname> ")

    if [[ "$hostname" =~ ^[A-Za-z_][A-Za-z0-9_-]*\$?$ ]]; then
      break
    elif [[ -z $hostname ]]; then
      hostname="omarchy"
      break
    else
      notice "Hostname must be alphanumeric using dashes or underscores but no spaces" 1
    fi
  done

  # Pick timezone
  geo_guessed_timezone=$(tzupdate -p 2>/dev/null)

  if [[ -n $geo_guessed_timezone ]]; then
    timezone=$(timedatectl list-timezones | gum choose --height 10 --selected "$geo_guessed_timezone" --header "Timezone") || abort
  else
    timezone=$(timedatectl list-timezones | gum filter --height 10 --header "Timezone") || abort
  fi
}

user_form

# STEP 3: PARTITION

partition_form() {
  step "Let's select where to install Omarchy..."

  selected_device=$(/root/omarchy/bin/omarchy-partition-select) || abort "No valid install target selected"
  device_type=$(lsblk -no TYPE "$selected_device" 2>/dev/null | head -n1)

  BOOT_PARTITION=""
  SUMMARY_BOOT_TARGET=""

  if [[ "$device_type" == "disk" ]]; then
    INSTALL_MODE="disk"
    INSTALL_DISK="$selected_device"
    disk="$selected_device"
    partition=""
    SUMMARY_INSTALL_TARGET="$selected_device (entire disk)"
    SUMMARY_BOOT_TARGET="[Will create ESP automatically]"
  else
    INSTALL_MODE="partition"
    partition="$selected_device"
    disk="/dev/$(lsblk -no PKNAME "$partition" 2>/dev/null | head -n1)"
    [[ -n "$disk" ]] || disk="(unknown)"
    BOOT_PARTITION=$(select_boot_partition "$partition")
    SUMMARY_INSTALL_TARGET="$partition"
    SUMMARY_BOOT_TARGET="$BOOT_PARTITION"
  fi
}

partition_form

while true; do
  gum style "The selected partition will be formatted and Omarchy will be installed to it."
  gum style "All data on the partition will be lost. There is no recovery possible."

  echo
  if gum confirm --affirmative "Yes, format partition" --negative "No, change it" "Confirm installing to ${partition}"; then
    break
  else
    partition_form
  fi
done

prepare_install_target
if [[ "$INSTALL_MODE" == "disk" && -n "$partition" ]]; then
  SUMMARY_INSTALL_TARGET="$partition"
fi

# Format and mount selected partition
step "Preparing partition for installation..."

# Unmount partition if already mounted
if mountpoint -q "$partition"; then
  umount "$partition" 2>/dev/null || true
fi

# Unmount any existing /mnt/archinstall
if mountpoint -q /mnt/archinstall; then
  umount -R /mnt/archinstall 2>/dev/null || true
fi

# Wipe existing filesystem signatures (handles previous LUKS headers, etc.)
echo "Wiping existing filesystem signatures..."
wipefs -a "$partition" >/dev/null 2>&1 || abort "Failed to wipe partition signatures"

# Format partition as BTRFS with compression
echo "Formatting ${partition} as BTRFS..."
mkfs.btrfs -f "$partition" >/dev/null 2>&1 || abort "Failed to format partition"

# Create mount point
mkdir -p /mnt/archinstall

# Mount partition
echo "Mounting partition at /mnt/archinstall..."
mount -o compress=zstd "$partition" /mnt/archinstall || abort "Failed to mount partition"

# Create BTRFS subvolumes
echo "Creating BTRFS subvolumes..."
btrfs subvolume create /mnt/archinstall/@ || abort "Failed to create @ subvolume"
btrfs subvolume create /mnt/archinstall/@home || abort "Failed to create @home subvolume"
btrfs subvolume create /mnt/archinstall/@log || abort "Failed to create @log subvolume"
btrfs subvolume create /mnt/archinstall/@pkg || abort "Failed to create @pkg subvolume"

# Unmount to remount with subvolumes
umount /mnt/archinstall

# Remount with subvolumes
mount -o compress=zstd,subvol=@ "$partition" /mnt/archinstall || abort "Failed to mount @ subvolume"
mkdir -p /mnt/archinstall/{home,var/log,var/cache/pacman/pkg}
mount -o compress=zstd,subvol=@home "$partition" /mnt/archinstall/home || abort "Failed to mount @home subvolume"
mount -o compress=zstd,subvol=@log "$partition" /mnt/archinstall/var/log || abort "Failed to mount @log subvolume"
mount -o compress=zstd,subvol=@pkg "$partition" /mnt/archinstall/var/cache/pacman/pkg || abort "Failed to mount @pkg subvolume"

mkdir -p /mnt/archinstall/boot
mount_boot_partition

# STEP 4: ADVANCED OPTIONS

step "Let's configure advanced installation options..."

# LUKS encryption prompt with profile-based defaults
  if [[ "$install_profile" == "Workstation" ]]; then
    luks_default="Yes"
  else
    luks_default="No"
  fi

  luks_choice=$(gum choose --header "Enable disk encryption (LUKS)?" --selected "$luks_default" "Yes" "No") || abort
  enable_luks=$([[ "$luks_choice" == "Yes" ]] && echo "true" || echo "false")

  # SSH server prompt with profile-based defaults
  if [[ "$install_profile" == "Workstation" ]]; then
    ssh_default="No"
  else
    ssh_default="Yes"
  fi

  ssh_choice=$(gum choose --header "Enable SSH server?" --selected "$ssh_default" "Yes" "No") || abort
  enable_ssh=$([[ "$ssh_choice" == "Yes" ]] && echo "true" || echo "false")

  # wayvnc prompt with profile-based defaults
  if [[ "$install_profile" == "Workstation" ]]; then
    wayvnc_default="No"
  else
    wayvnc_default="Yes"
  fi

  wayvnc_choice=$(gum choose --header "Enable wayvnc (VNC remote access)?" --selected "$wayvnc_default" "Yes" "No") || abort
  enable_wayvnc=$([[ "$wayvnc_choice" == "Yes" ]] && echo "true" || echo "false")

  # Keybinding remap prompt with profile-based defaults
  if [[ "$install_profile" == "Workstation" ]]; then
    remap_default="No"
  else
    remap_default="Yes"
  fi

  remap_choice=$(gum choose \
    --header "Remap keybindings for VM-friendly modifiers? (Map Super bindings to CTRL+ALT)" \
    --selected "$remap_default" \
    "Yes" "No") || abort
  remap_keybindings=$([[ "$remap_choice" == "Yes" ]] && echo "true" || echo "false")

  # NOTE: Autologin has been removed in favor of greetd display manager
  # greetd provides a proper login screen with VNC remote access support
  # Users always see a login prompt (more secure, more standard)

# STEP 5: SUMMARY AND CONFIRMATION

while true; do
  # Add manual padding since gum table -p doesn't respect padding
  summary_table="Field,Value
Username,$username
Password,$(printf "%${#password}s" | tr ' ' '*')
Full name,${full_name:-[Skipped]}
Email address,${email_address:-[Skipped]}
Hostname,$hostname
Timezone,$timezone
Keyboard,$keyboard
Install Target,$SUMMARY_INSTALL_TARGET
Boot Partition,$SUMMARY_BOOT_TARGET
Profile,$install_profile
LUKS Encryption,$([[ "$enable_luks" == "true" ]] && echo "Enabled" || echo "Disabled")
SSH Server,$([[ "$enable_ssh" == "true" ]] && echo "Enabled" || echo "Disabled")
VNC Access (wayvnc),$([[ "$enable_wayvnc" == "true" ]] && echo "Enabled" || echo "Disabled")
Keybinding Remap,$([[ "$remap_keybindings" == "true" ]] && echo "Enabled (CTRL+ALT bindings)" || echo "Disabled")"

  echo -e "$summary_table" | gum table -s "," -p | sed "s/^/${PADDING_LEFT_SPACES}/"

  echo
  if gum confirm --negative "No, change it" "Confirm installing to ${SUMMARY_INSTALL_TARGET}"; then
    break
  else
    # User wants to change settings - restart the entire flow
    keyboard_form
    user_form
    disk_form

    # Re-run advanced prompts
    step "Let's reconfigure advanced installation options..."

    # LUKS encryption prompt
      if [[ "$install_profile" == "Workstation" ]]; then
        luks_default="Yes"
      else
        luks_default="No"
      fi
      luks_choice=$(gum choose --header "Enable disk encryption (LUKS)?" --selected "$luks_default" "Yes" "No") || abort
      enable_luks=$([[ "$luks_choice" == "Yes" ]] && echo "true" || echo "false")

      # SSH server prompt
      if [[ "$install_profile" == "Workstation" ]]; then
        ssh_default="No"
      else
        ssh_default="Yes"
      fi
      ssh_choice=$(gum choose --header "Enable SSH server?" --selected "$ssh_default" "Yes" "No") || abort
      enable_ssh=$([[ "$ssh_choice" == "Yes" ]] && echo "true" || echo "false")

      # wayvnc prompt
      if [[ "$install_profile" == "Workstation" ]]; then
        wayvnc_default="No"
      else
        wayvnc_default="Yes"
      fi
      wayvnc_choice=$(gum choose --header "Enable wayvnc (VNC remote access)?" --selected "$wayvnc_default" "Yes" "No") || abort
      enable_wayvnc=$([[ "$wayvnc_choice" == "Yes" ]] && echo "true" || echo "false")

      # NOTE: Autologin removed in favor of greetd (see above)
  fi
done

clear

# Save user full name and email address, so the autostart can
# set them as OMARCHY_USER_NAME and OMARCHY_USER_EMAIL
echo "$full_name" >user_full_name.txt
echo "$email_address" >user_email_address.txt

# Escape username and password for safe inclusion
password_escaped=$(echo -n "$password" | jq -Rsa)
password_hash_escaped=$(echo -n "$password_hash" | jq -Rsa)
username_escaped=$(echo -n "$username" | jq -Rsa)

cat <<-_EOF_ >user_credentials.json
{
    "encryption_password": $password_escaped,
    "root_enc_password": $password_hash_escaped,
    "users": [
        {
            "enc_password": $password_hash_escaped,
            "groups": [],
            "sudo": true,
            "username": $username_escaped
        }
    ]
}
_EOF_

# Detect T2 Mac and set appropriate kernel
if lspci -nn 2>/dev/null | grep -q "106b:180[12]"; then
  kernel_choice="linux-t2"
else
  kernel_choice="linux"
fi

cat <<-_EOF_ >user_configuration.json
{
    "app_config": null,
    "archinstall-language": "English",
    "auth_config": {},
    "audio_config": { "audio": "pipewire" },
    "bootloader": "Limine",
    "custom_commands": [],
    "disk_config": {
        "btrfs_options": {
          "snapshot_config": {
            "type": "Snapper"
          }
        },
        "config_type": "Pre_mount",
        "device_modifications": []_DISK_ENCRYPTION_PLACEHOLDER_
    },
    "hostname": "$hostname",
    "kernels": [ "$kernel_choice" ],
    "network_config": { "type": "iso" },
    "ntp": true,
    "parallel_downloads": 8,
    "script": null,
    "services": [],
    "swap": true,
    "timezone": "$timezone",
    "locale_config": {
        "kb_layout": "$keyboard",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "mirror_config": {
        "custom_repositories": [],
        "custom_servers": [
            {"url": "https://mirror.omarchy.org/\$repo/os/\$arch"},
            {"url": "https://mirror.rackspace.com/archlinux/\$repo/os/\$arch"},
            {"url": "https://geo.mirror.pkgbuild.com/\$repo/os/\$arch"}
        ],
        "mirror_regions": {},
        "optional_repositories": []
    },
    "packages": [
        "base-devel",
        "git"
    ],
    "profile_config": {
        "gfx_driver": null,
        "greeter": null,
        "profile": {}
    },
    "version": "3.0.9"
}
_EOF_

# Conditionally include LUKS encryption in JSON based on enable_luks setting
if [[ "$enable_luks" == "true" ]]; then
  # Include disk encryption configuration
  sed -i 's|]_DISK_ENCRYPTION_PLACEHOLDER_|],\n        "disk_encryption": {\n            "encryption_type": "luks",\n            "lvm_volumes": [],\n            "iter_time": 2000,\n            "partitions": [ "8c2c2b92-1070-455d-b76a-56263bab24aa" ],\n            "encryption_password": '"$password_escaped"'\n        }|' user_configuration.json
else
  # Exclude disk encryption configuration
  sed -i 's|]_DISK_ENCRYPTION_PLACEHOLDER_|]|' user_configuration.json
fi

# Generate advanced state file for omarchy installer
cat <<-_EOF_ >omarchy_advanced_state.json
{
